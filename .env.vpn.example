# Copy to .env (already gitignored), chmod 600, and fill in credentials from
# a VPN provider supported by Gluetun: https://github.com/qdm12/gluetun-wiki
#
# WireGuard is strongly preferred for high-bitrate/4K playback.
VPN_SERVICE_PROVIDER=your-provider
VPN_TYPE=wireguard
VPN_SERVER_COUNTRIES=Finland

# Provider-specific WireGuard credentials. Some providers only require the
# private key; others also expose the tunnel address in their dashboard.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Only used if VPN_TYPE=openvpn.
OPENVPN_USER=
OPENVPN_PASSWORD=

TZ=Europe/Helsinki
